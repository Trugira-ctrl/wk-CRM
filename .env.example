# Copy to .env only on your own workstation/VPS. Never commit .env.
# Choose your own password (URL-safe alphanumeric recommended in this demo).
POSTGRES_PASSWORD=replace-with-a-long-random-value
HTTP_PORT=8088
DEMO_MODE=true
ENVIRONMENT=demo
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:8088

# On an HTTPS VPS set COOKIE_SECURE=true and terminate TLS at your proxy.
# Keep a demo site access-restricted and use fictional records only.
# For real production: ENVIRONMENT=production, DEMO_MODE=false, and provision
# non-demo staff accounts before switching. The public demo passwords are blocked.
# Keep the same POSTGRES_PASSWORD for an existing volume; editing this variable
# does not rotate the password already stored in PostgreSQL.

# Non-Docker development: supply your own PostgreSQL URL through the environment.
# DATABASE_URL=postgresql+psycopg://waka:YOUR_PASSWORD@localhost:5432/waka
# PORT=8080

# Reserved for future signed webhooks; no integration uses these yet.
# APP_SECRET=
# WEBHOOK_SECRET=
PAYMENT_PROVIDER_MODE=simulated
MESSAGING_PROVIDER_MODE=simulated
GATE_PROVIDER_MODE=simulated

# Production requires DEMO_MODE=false, COOKIE_SECURE=true, PostgreSQL,
# and an explicit comma-separated HTTPS origin list. No real providers exist.
ALLOWED_ORIGINS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
# Session cookies use random opaque tokens, stored hashed in PostgreSQL.
# SESSION_SECRET is not used by this implementation (cookies are not signed JWTs).