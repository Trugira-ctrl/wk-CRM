# Copy to .env only on your own workstation/VPS. Never commit .env.
# Choose your own password (URL-safe alphanumeric recommended in this demo).
POSTGRES_PASSWORD=replace-with-a-long-random-value
HTTP_PORT=8088
DEMO_MODE=true
ENVIRONMENT=demo
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:8088

# Non-Docker development: supply your own PostgreSQL URL through the environment.
# DATABASE_URL=postgresql+psycopg://waka:YOUR_PASSWORD@localhost:5432/waka
# PORT=8080

# Reserved for future signed webhooks; no integration uses these yet.
# APP_SECRET=
# WEBHOOK_SECRET=
PAYMENT_PROVIDER_MODE=simulated
MESSAGING_PROVIDER_MODE=simulated
GATE_PROVIDER_MODE=simulated