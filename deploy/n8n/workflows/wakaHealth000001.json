{
  "id": "wakaHealth000001",
  "name": "WAKA - Health check",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "check-waka-database-health",
      "name": "Check WAKA database health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        120
      ],
      "parameters": {
        "url": "http://backend:8080/health/db",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "record-internal-result",
      "name": "Record internal result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        120
      ],
      "parameters": {
        "url": "http://backend:8080/internal/automation/results",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({workflow:'health-check', day:$now.setZone('Africa/Kigali').toISODate(), status:$json.status === 'ok' ? 'HEALTHY' : 'UNHEALTHY', summary:$json.status === 'ok' ? 'WAKA API and database are reachable' : 'WAKA health check failed; inspect the n8n execution', payload:{checked_at:$now.toISO(), api_status:$json.status || 'error'} }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "wakaAutomation001",
          "name": "WAKA limited automation API"
        }
      }
    }
  ],
  "connections": {
    "Run manually": {
      "main": [
        [
          {
            "node": "Check WAKA database health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule": {
      "main": [
        [
          {
            "node": "Check WAKA database health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check WAKA database health": {
      "main": [
        [
          {
            "node": "Record internal result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Kigali",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "tags": []
}
