{
  "id": "wakaExpiry000001",
  "name": "WAKA - Membership expiry reminders",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "read-waka-expiry-summary",
      "name": "Read WAKA expiry summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        120
      ],
      "parameters": {
        "url": "http://backend:8080/internal/automation/snapshot",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "wakaAutomation001",
          "name": "WAKA limited automation API"
        }
      }
    },
    {
      "id": "record-internal-result",
      "name": "Record internal result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        120
      ],
      "parameters": {
        "url": "http://backend:8080/internal/automation/results",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({workflow:'membership-expiry', day:$json.day, status:'DRAFT', summary:$json.metrics.expiring_members + ' membership(s) expire within seven days. Staff reminder review; no messages sent.', payload:{members:$json.expiring_members, total:$json.metrics.expiring_members, truncated:$json.expiring_list_truncated}}) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "wakaAutomation001",
          "name": "WAKA limited automation API"
        }
      }
    }
  ],
  "connections": {
    "Run manually": {
      "main": [
        [
          {
            "node": "Read WAKA expiry summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule": {
      "main": [
        [
          {
            "node": "Read WAKA expiry summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read WAKA expiry summary": {
      "main": [
        [
          {
            "node": "Record internal result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Kigali",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "tags": []
}
