{
	default_sni {$PUBLIC_HOST}
	servers {
		protocols h1 h2
	}
}

https://{$PUBLIC_HOST} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_http_challenge
		}
	}
	reverse_proxy proxy:80 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
